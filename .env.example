# Vorlage. Kopie als .env anlegen und ausfuellen. Die .env selbst gehoert in
# kein Repository und auf keinen Server.

# Cursor User API Key: cursor.com/dashboard -> Integrations -> API Keys.
# Achtung, der Schluessel hat Vollzugriff auf das Cursor-Konto.
CURSOR_API_KEY=

# Bot-Token vom BotFather in Telegram.
XTECU_BOT_TOKEN=

# Nur diese Chat-ID darf Befehle geben. Leer lassen, den Dienst starten, dem
# Bot schreiben - er nennt die ID, dann hier eintragen und neu starten.
XTECU_CHAT_ID=
